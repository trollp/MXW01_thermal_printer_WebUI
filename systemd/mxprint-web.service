# User service for the MXW01 web UI.
# Install:
#   mkdir -p ~/.config/systemd/user
#   sed "s|__DIR__|$PWD|" systemd/mxprint-web.service > ~/.config/systemd/user/mxprint-web.service
#   systemctl --user daemon-reload && systemctl --user enable --now mxprint-web
[Unit]
Description=MXW01 thermal printer web UI
After=bluetooth.target

[Service]
ExecStart=__DIR__/mxprint-web
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
